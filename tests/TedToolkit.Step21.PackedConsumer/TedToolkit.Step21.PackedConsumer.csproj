<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishAot Condition="'$(NativeAotProof)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <ItemGroup Condition="'$(Ap203PackageProof)' != 'true' and '$(Ap214PackageProof)' != 'true' and '$(Ap242PackageProof)' != 'true' and '$(Ap203Ap214PackageProof)' != 'true' and '$(Ap203Ap242PackageProof)' != 'true'">
    <PackageReference Include="TedToolkit.Step21" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap203PackageProof)' == 'true'">
    <PackageReference Include="TedToolkit.Step21.Ap203" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap214PackageProof)' == 'true'">
    <PackageReference Include="TedToolkit.Step21.Ap214" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap242PackageProof)' == 'true'">
    <PackageReference Include="TedToolkit.Step21.Ap242" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap203Ap214PackageProof)' == 'true'">
    <PackageReference Include="TedToolkit.Step21.Ap203" />
    <PackageReference Include="TedToolkit.Step21.Ap214" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap203Ap242PackageProof)' == 'true'">
    <PackageReference Include="TedToolkit.Step21.Ap203" />
    <PackageReference Include="TedToolkit.Step21.Ap242" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap203PackageProof)' != 'true' and '$(Ap214PackageProof)' != 'true' and '$(Ap242PackageProof)' != 'true' and '$(Ap203Ap214PackageProof)' != 'true' and '$(Ap203Ap242PackageProof)' != 'true'">
    <AdditionalFiles Include="catalog-core.exp" />
    <AdditionalFiles Include="catalog-model.exp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Ap203Program.cs" />
    <Compile Remove="Ap203FixtureProgram.cs" />
    <Compile Remove="Ap214Program.cs" />
    <Compile Remove="Ap214FixtureProgram.cs" />
    <Compile Remove="Ap242Program.cs" />
    <Compile Remove="Ap242FixtureProgram.cs" />
    <Compile Remove="Ap203Ap214Program.cs" />
    <Compile Remove="Ap203Ap242Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap203PackageProof)' == 'true' and '$(Ap203FixtureProof)' != 'true'">
    <Compile Remove="Program.cs" />
    <Compile Include="Ap203Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap203PackageProof)' == 'true' and '$(Ap203FixtureProof)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Include="Ap203FixtureProgram.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap214PackageProof)' == 'true' and '$(Ap214FixtureProof)' != 'true'">
    <Compile Remove="Program.cs" />
    <Compile Include="Ap214Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap214PackageProof)' == 'true' and '$(Ap214FixtureProof)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Include="Ap214FixtureProgram.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap242PackageProof)' == 'true' and '$(Ap242FixtureProof)' != 'true'">
    <Compile Remove="Program.cs" />
    <Compile Include="Ap242Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap242PackageProof)' == 'true' and '$(Ap242FixtureProof)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Include="Ap242FixtureProgram.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap203Ap214PackageProof)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Include="Ap203Ap214Program.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Ap203Ap242PackageProof)' == 'true'">
    <Compile Remove="Program.cs" />
    <Compile Include="Ap203Ap242Program.cs" />
  </ItemGroup>

</Project>
