<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RCS1046</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\build\TedToolkit.Step21.SchemaInputs.targets" />

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TedToolkit.Step21\TedToolkit.Step21.csproj" />
    <ProjectReference Include="..\..\src\TedToolkit.Step21.Analyzer\TedToolkit.Step21.Analyzer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ExpressSchemaInput Include="$(ExpressSchemaCacheRoot)\ap203\mim_lf.exp;$(ExpressSchemaCacheRoot)\ap214\AP214E3_2010.exp;$(ExpressSchemaCacheRoot)\ap242\mim_lf.compat.exp" />
    <Compile Include="..\TedToolkit.Step21.PackedConsumer\Part21FixtureSignature.cs"
             Link="PackageFixtureTests\Part21FixtureSignature.cs" />
    <None Update="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ExpressSchemaCacheRoot)\ap242\mim_lf.exp"
          Link="TestData\Express\Ap242\mim_lf.exp"
          CopyToOutputDirectory="Always" />
    <None Include="$(ExpressSchemaCacheRoot)\ap242\mim_lf.compat.exp"
          Link="TestData\Express\Ap242\mim_lf.compat.exp"
          CopyToOutputDirectory="Always" />
    <None Include="..\..\schemas\ap242\*"
          Link="TestData\Express\Ap242\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ExpressSchemaCacheRoot)\ap203\mim_lf.exp"
          Link="TestData\Express\Ap203\mim_lf.exp"
          CopyToOutputDirectory="Always" />
    <None Include="..\..\schemas\ap203\PROVENANCE.md;..\..\schemas\ap203\BASELINE.json"
          Link="TestData\Express\Ap203\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ExpressSchemaCacheRoot)\ap214\AP214E3_2010.exp"
          Link="TestData\Express\Ap214\AP214E3_2010.exp"
          CopyToOutputDirectory="Always" />
    <None Include="..\..\schemas\ap214\PROVENANCE.md"
          Link="TestData\Express\Ap214\PROVENANCE.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schemas\ap214\PublicApi.approved.sha256"
          Link="TestData\Express\Ap214\PublicApi.approved.sha256"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
