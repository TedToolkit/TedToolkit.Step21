<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/TedToolkit/TedToolkit.Step21</PackageProjectUrl>
  </PropertyGroup>
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('TedToolkit.Step21.Ap'))">
    <!-- Generated AP sources carry explicit annotations; flow warnings add multi-gigabyte compiler cost. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>
</Project>
