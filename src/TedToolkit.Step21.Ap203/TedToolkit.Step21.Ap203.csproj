<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Version>2.0.0</Version>
    <Description>Precompiled ISO/TS 10303-403 AP203 MIM long-form types for TedToolkit.Step21.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageTags>step;iso-10303;ap203;config-control-design</PackageTags>
    <ExpressSchemaId>ap203</ExpressSchemaId>
  </PropertyGroup>

  <Import Project="..\..\build\TedToolkit.Step21.SchemaInputs.targets" />

  <ItemGroup>
    <ProjectReference Include="..\TedToolkit.Step21\TedToolkit.Step21.csproj"
                      PrivateAssets="all" />
    <PackageReference Include="TedToolkit.Step21"
                      VersionOverride="[1.0.0,2.0.0)" />
    <ProjectReference Include="..\TedToolkit.Step21.Analyzer\TedToolkit.Step21.Analyzer.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="..\TedToolkit.Step21.Analyzer\bin\$(Configuration)\netstandard2.0\TedToolkit.Step21.Analyzer.dll" />
    <Analyzer Include="..\TedToolkit.Step21.Analyzer\bin\$(Configuration)\netstandard2.0\Antlr4.Runtime.Standard.dll" />
    <Analyzer Include="..\TedToolkit.Step21.Analyzer\bin\$(Configuration)\netstandard2.0\System.Memory.dll" />
    <Analyzer Include="..\TedToolkit.Step21.Analyzer\bin\$(Configuration)\netstandard2.0\TedToolkit.RoslynHelper.dll" />
    <Analyzer Include="..\TedToolkit.Step21.Analyzer\bin\$(Configuration)\netstandard2.0\ZString.dll" />
  </ItemGroup>

  <ItemGroup>
    <ExpressSchemaInput Include="$(ExpressSchemaCacheRoot)\ap203\mim_lf.exp" />
    <AdditionalFiles Include="@(ExpressSchemaInput)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\schemas\ap203\PROVENANCE.md;..\..\schemas\SOURCES.md"
          Pack="true"
          PackagePath="third-party/schema-source/"
          Visible="false" />
    <None Include="README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

</Project>
