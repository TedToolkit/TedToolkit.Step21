<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Optional ISO 10303-21:2016 Annex F ECMAScript binding for TedToolkit.Step21.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageTags>step;iso-10303;part21;ecmascript;annex-f</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TedToolkit.Step21\TedToolkit.Step21.csproj"
                      PrivateAssets="all" />
    <PackageReference Include="TedToolkit.Step21"
                      VersionOverride="[1.0.0,2.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AnnexF.js"
                      LogicalName="TedToolkit.Step21.AnnexF.AnnexF.js" />
    <None Update="AnnexF.js"
          Pack="true"
          PackagePath="contentFiles/any/any/TedToolkit.Step21.AnnexF/" />
    <None Include="README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

</Project>
